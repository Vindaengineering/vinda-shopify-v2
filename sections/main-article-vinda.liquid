{%- comment -%}
  Article — full-bleed hero image, centered max-width body column, back link footer.
{%- endcomment -%}

<article class="v-article">
  <header class="v-article__header" data-reveal>
    <div class="v-container v-container--narrow">
      <p class="v-article__meta v-mono">
        <a href="{{ blog.url }}">{{ blog.title }}</a>
        <span aria-hidden="true"> · </span>
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>
        {%- if article.tags.size > 0 -%}
          <span aria-hidden="true"> · </span>{{ article.tags.first }}
        {%- endif -%}
      </p>
      <h1 class="v-display v-article__title">{{ article.title }}</h1>
      {%- if article.excerpt != blank -%}
        <p class="v-article__lede">{{ article.excerpt | strip_html }}</p>
      {%- endif -%}
      <p class="v-article__byline v-mono">
        {%- if article.author != blank -%}
          {{ 'blogs.article.by' | t }} {{ article.author }}
        {%- endif -%}
      </p>
    </div>
  </header>

  {%- if article.image -%}
    <div class="v-article__hero" data-reveal style="--reveal-i: 1;">
      {%- assign hero_alt = article.image.alt | default: article.title -%}
      {{ article.image | image_url: width: 2000 | image_tag: alt: hero_alt, class: 'v-article__hero-img', widths: '800,1200,1600,2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    </div>
  {%- endif -%}

  <div class="v-container v-container--narrow">
    <div class="v-article__body rte" data-reveal style="--reveal-i: 2;">
      {{ article.content }}
    </div>

    <footer class="v-article__footer">
      <a href="{{ blog.url }}" class="v-btn-outline">← {{ 'blogs.article.back_to_blog' | t }}</a>
    </footer>
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
